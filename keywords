#!/usr/bin/env bash
# keywords - Extract keywords and keyphrases from text using Anthropic Claude
# Optimized for web search and RAG retrieval systems
set -euo pipefail
shopt -s inherit_errexit shift_verbose nullglob extglob

# User tooling: ~/.local/bin stays so a per-user install of stopwords is still found
declare -rx PATH=~/.local/bin:/usr/local/bin:/usr/bin:/bin

### VERSION managed by version
declare -r VERSION=1.1.0
###
#shellcheck disable=SC2155  # realpath of our own path does not fail; declare -r needs one statement
declare -r SCRIPT_PATH=$(realpath -- "${BASH_SOURCE[0]}")
declare -r SCRIPT_NAME=${SCRIPT_PATH##*/}

# API settings
declare -r API_URL='https://api.anthropic.com/v1/messages'
declare -r API_VERSION='2023-06-01'
declare -- ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY:-}
declare -- ANTHROPIC_MODEL=${ANTHROPIC_MODEL:-claude-haiku-5-5}

# Default options
declare -i MAX_KEYWORDS=20
declare -i API_TIMEOUT=60
# Thinking tokens count against this cap on models that think by default
declare -i MAX_TOKENS=8000
declare -i STOPWORDS=0
declare -i USE_CACHE=1
declare -i INCLUDE_SCORES=0
declare -i INCLUDE_TYPES=0
declare -i INCLUDE_ENTITIES=0
declare -i VERBOSE=1
declare -i DRY_RUN=0
declare -- OUTPUT_FORMAT='text'
declare -- MIN_SCORE='0.0'
declare -- OUTPUT_FILE=''
declare -- CACHE_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/keywords

# Cache settings
declare -ri CACHE_TTL=86400
# Part of the cache key: bump it when build_prompt changes so old results are not reused
declare -r PROMPT_VERSION='2'

# Run state
declare -i CACHE_HITS=0
declare -i API_CALLS=0
declare -a TEMP_FILES=()

# Message helpers
if [[ -t 1 && -t 2 ]]; then
  declare -r RED=$'\033[0;31m' GREEN=$'\033[0;32m' YELLOW=$'\033[0;33m' CYAN=$'\033[0;36m' NC=$'\033[0m'
else
  declare -r RED='' GREEN='' YELLOW='' CYAN='' NC=''
fi

_msg() {
  local -- prefix="$SCRIPT_NAME: $1" msg
  shift
  for msg in "$@"; do
    >&2 printf '%s %s\n' "$prefix" "$msg"
  done
}
error()   { _msg "$RED✗$NC" "$@"; }
die()     { (($# < 2)) || error "${@:2}"; exit "${1:-0}"; }
warn()    { _msg "$YELLOW▲$NC" "$@"; }
info()    { ((VERBOSE)) || return 0; _msg "$CYAN◉$NC" "$@"; }
success() { ((VERBOSE)) || return 0; _msg "$GREEN✓$NC" "$@"; }

# Usage errors exit 2 under the published contract (0/1/2), not BCS0602's 22
#bcscheck disable=BCS0602
noarg() { (($# > 1)) || die 2 "Missing value for ${1@Q}"; }

# Integer options are declare -i: assigning unchecked text evaluates it as arithmetic,
# which runs any command substitution inside an array subscript
#bcscheck disable=BCS0602  # usage errors exit 2 under the published 0/1/2 contract, not 22
int_arg() {
  [[ $2 =~ ^[1-9][0-9]{0,6}$ ]] || die 2 "Invalid value ${2@Q} for ${1@Q} (positive integer)"
}

cleanup() {
  ((${#TEMP_FILES[@]})) || return 0
  rm -f -- "${TEMP_FILES[@]}"
}

show_usage() {
  cat <<HELP
$SCRIPT_NAME $VERSION - Extract keywords and keyphrases from text

Usage: $SCRIPT_NAME [OPTIONS] [FILE]

Extract keywords and keyphrases from text using Anthropic Claude.
Optimized for web search and RAG retrieval systems.

INPUT:
  FILE                    Input text file; '-' or no FILE reads stdin

OPTIONS:
  -h, --help              Show this help
  -V, --version           Print version
  -m, --model MODEL       Claude model to use:
                            haiku-5-5  (default, fast & cost-effective)
                            sonnet-5-5 (advanced, better accuracy)
                            opus-5-5   (premium, best quality)
  -n, --max-keywords N    Maximum keywords to extract (default: 20)
  -f, --format FORMAT     Output format:
                            text  (default, one per line)
                            json  (structured with metadata)
                            csv   (quoted rows; header line on stderr)
  -s, --scores            Include relevance scores (0.0-1.0)
  -t, --types             Include keyword types (concept/technical/entity)
  -e, --entities          Extract named entities separately
  --min-score FLOAT       Minimum relevance score, 0.0-1.0 (default: 0.0)
  -o, --output FILE       Write output to FILE (left untouched if extraction fails)
  --timeout SECONDS       API timeout in seconds (default: 60)
  --max-tokens N          Maximum response tokens, thinking included (default: 8000)
  -S, --stopwords         Remove stopwords from input text (requires stopwords)
  --no-cache              Disable result caching
  --cache-dir DIR         Cache directory (default: ~/.cache/keywords)
  -v, --verbose           Progress messages (the default; undoes -q)
  -q, --quiet             Quiet mode (no progress messages)
  --dry-run               Show what would be done without API calls
  --                      End of options; the next argument is FILE

ENVIRONMENT:
  ANTHROPIC_API_KEY       Your Anthropic API key (not needed for --dry-run or cache hits)
  ANTHROPIC_MODEL         Default model (same values as --model)

EXIT STATUS:
  0 success, 1 runtime error, 2 usage error

EXAMPLES:
  # Extract keywords from file (text output)
  $SCRIPT_NAME document.txt

  # Use advanced model with scores
  $SCRIPT_NAME -m sonnet -s document.txt

  # JSON output with entity extraction
  $SCRIPT_NAME -f json -e document.txt

  # From stdin
  echo 'Text about Claude API and RAG systems' | $SCRIPT_NAME

  # Batch processing
  for file in docs/*.txt; do
    $SCRIPT_NAME "\$file" > "keywords/\$(basename "\${file%.txt}").txt"
  done
HELP
}

# Cache functions

# --min-score is applied after the cache, so it is not part of the key
generate_cache_key() {
  local -- params="$PROMPT_VERSION:$ANTHROPIC_MODEL:$MAX_KEYWORDS:$INCLUDE_ENTITIES"
  printf '%s' "$1$params" | sha256sum | cut -d' ' -f1
}

get_cached_result() {
  local -- cache_file="$CACHE_DIR/$1.json" cached
  local -i mtime

  [[ -f $cache_file ]] || return 1
  mtime=$(stat -c %Y -- "$cache_file") || return 1
  ((EPOCHSECONDS - mtime < CACHE_TTL)) || return 1
  cached=$(< "$cache_file") || return 1
  # A damaged entry counts as a miss and is overwritten by the fresh result
  jq -e '.keywords | type == "array"' <<< "$cached" &>/dev/null || return 1
  printf '%s' "$cached"
}

# Temp file then mv, so a parallel run never reads a partly written entry
save_to_cache() {
  local -- cache_file="$CACHE_DIR/$1.json" tmp_file

  #shellcheck disable=SC2174  # -m applies to the deepest dir only, which is the one we own
  mkdir -p -m 700 -- "$CACHE_DIR" || return 1
  tmp_file=$(umask 077; mktemp -- "$CACHE_DIR"/.tmp.XXXXXX) || return 1
  TEMP_FILES+=("$tmp_file")
  printf '%s' "$2" > "$tmp_file" || return 1
  mv -f -- "$tmp_file" "$cache_file" || return 1
  # Without this, expired entries stay until the same input is requested again
  find -- "$CACHE_DIR" -maxdepth 1 -name '*.json' -mmin +$((CACHE_TTL / 60)) -delete 2>/dev/null ||:
}

# API functions

build_prompt() {
  local -- entity_instruction=''

  if ((INCLUDE_ENTITIES)); then
    entity_instruction='
- Named entities (people, organizations, locations, products)
- Proper nouns and brand names'
  fi

  cat <<PROMPT
<task>
Extract the $MAX_KEYWORDS most important keywords and keyphrases from the text below.
Focus on terms that would be most useful for search queries and document retrieval.
</task>

<instructions>
1. Identify key concepts, topics, and themes
2. Preserve multi-word phrases (2-4 words) when they represent single concepts$entity_instruction
3. Include technical terms and domain-specific vocabulary
4. Rank by relevance and importance
5. Assign relevance scores (0.0-1.0, where 1.0 is most important)
6. Categorize each term by type:
   - concept: Abstract ideas, themes, methodologies
   - technical: Technologies, tools, frameworks, APIs
   - entity: People, organizations, locations, products
   - action: Key processes, activities, operations
</instructions>

<text>
$1
</text>

<output_format>
Return ONLY valid JSON with this exact structure (no other text):
{
  "keywords": [
    {"term": "example phrase", "score": 0.95, "type": "concept"},
    {"term": "another term", "score": 0.88, "type": "technical"}
  ]
}
</output_format>
PROMPT
}

call_anthropic_api() {
  local -- request_body response stop_reason content

  info "Calling Anthropic API ${ANTHROPIC_MODEL@Q} ..."

  # The prompt reaches jq through a file descriptor and the body reaches curl on stdin:
  # argv is readable by every local user (ps), and one argument is capped at 128 KB
  request_body=$(jq -n \
    --arg model "$ANTHROPIC_MODEL" \
    --argjson max_tokens "$MAX_TOKENS" \
    --rawfile prompt <(printf '%s' "$1") \
    '{model: $model, max_tokens: $max_tokens, messages: [{role: "user", content: $prompt}]}') || {
    error 'Failed to build API request'
    return 1
  }

  # The key goes to curl as a header file on a file descriptor: printf is a builtin,
  # so the value never appears in any process's argv (ps, /proc/PID/cmdline).
  # --retry covers timeouts and HTTP 408, 429, 500, 502, 503 and 504, but not the API's
  # 529 (overloaded); curl holds the body in memory to resend it
  response=$(curl -sS --max-time "$API_TIMEOUT" --connect-timeout 10 --retry 2 \
    -H @<(printf 'x-api-key: %s\n' "$ANTHROPIC_API_KEY") \
    -H "anthropic-version: $API_VERSION" \
    -H 'content-type: application/json' \
    --data-binary @- \
    "$API_URL" <<< "$request_body") || {
    error 'API request failed'
    return 1
  }

  if jq -e '.error' <<< "$response" &>/dev/null; then
    local -- error_type error_message
    error_type=$(jq -r '.error.type // "unknown"' <<< "$response")
    error_message=$(jq -r '.error.message // empty' <<< "$response")
    error "API error ${error_type@Q}: $error_message"
    return 1
  fi

  # A refused or truncated response is HTTP 200 with no usable JSON in it
  stop_reason=$(jq -r '.stop_reason // empty' <<< "$response") || {
    error 'Failed to parse API response'
    return 1
  }
  case $stop_reason in
    refusal)
      error 'Request declined by the model (stop_reason: refusal)'
      return 1
      ;;
    max_tokens)
      error "Response truncated at $MAX_TOKENS tokens; raise --max-tokens"
      return 1
      ;;
    *) ;;
  esac

  # Select by type: a response can begin with thinking blocks, which have no .text
  content=$(jq -r '[.content[]? | select(.type == "text") | .text] | join("")' <<< "$response") || {
    error 'Failed to parse API response'
    return 1
  }
  printf '%s' "$content"
}

# Take the text from the first { to the last }: that drops a ```json fence or prose
# around the object, and survives pretty-printing and braces inside strings.
# Also enforces the item shape and the --max-keywords limit
parse_json_result() {
  local -- json=$1

  if [[ $json == *'{'*'}'* ]]; then
    json=${json#*\{}
    json=${json%\}*}
    if json=$(jq -ce --argjson n "$MAX_KEYWORDS" '
        select(.keywords | type == "array" and all(.[]; (.term | type) == "string"))
        | .keywords |= .[:$n]' <<< "{$json}" 2>/dev/null); then
      printf '%s' "$json"
      return 0
    fi
  fi

  error 'Could not parse valid JSON from response'
  return 1
}

# Output formatting

filter_by_score() {
  jq -c --arg min "$MIN_SCORE" '($min | tonumber) as $min
    | if $min > 0 then .keywords |= map(select(.score >= $min)) else . end' <<< "$1"
}

output_fields() {
  local -- fields='term'
  ((INCLUDE_SCORES)) && fields+=',score' ||:
  ((INCLUDE_TYPES)) && fields+=',type' ||:
  printf '%s' "$fields"
}

format_as_text() {
  jq -r --arg fields "$(output_fields)" \
    '.keywords[] | [.[($fields | split(","))[]] | tostring] | join("|")' <<< "$1"
}

# The header goes to stderr (since 021c4a3) so batches appended to one file
# get no repeated header rows; it labels the columns for a person, it is not data
#bcscheck disable=BCS0702
format_as_csv() {
  local -- fields
  fields=$(output_fields)
  >&2 echo "$fields"
  jq -r --arg fields "$fields" '.keywords[] | [.[($fields | split(","))[]]] | @csv' <<< "$1"
}

format_as_json() {
  jq --arg model "$ANTHROPIC_MODEL" \
     --argjson api_calls "$API_CALLS" \
     --argjson cache_hits "$CACHE_HITS" \
     '. + {
       metadata: {
         model: $model,
         timestamp: (now | todate),
         extraction_method: "llm",
         api_calls: $api_calls,
         cache_hits: $cache_hits
       }
     }' <<< "$1"
}

# Keyword extraction

extract_keywords() {
  local -- input_text=$1 cache_key='' json_result='' prompt api_response
  local -i text_length=${#input_text}

  [[ $input_text == *[![:space:]]* ]] || { error 'Empty input text'; return 1; }
  ((text_length >= 30)) || { error 'Input too short (minimum 30 characters)'; return 1; }
  ((text_length < 200000)) || warn "Large input ($text_length chars) may be slow"

  if ((USE_CACHE)); then
    cache_key=$(generate_cache_key "$input_text")
    if json_result=$(get_cached_result "$cache_key"); then
      CACHE_HITS+=1
      success 'Cache hit'
    else
      json_result=''
    fi
  fi

  if [[ -z $json_result ]]; then
    if ((DRY_RUN)); then
      info "[DRY-RUN] Would call API with $text_length characters"
      json_result='{"keywords":[{"term":"dry-run","score":1.0,"type":"test"}]}'
    else
      [[ -n $ANTHROPIC_API_KEY ]] || { error 'ANTHROPIC_API_KEY environment variable not set'; return 1; }
      prompt=$(build_prompt "$input_text")
      api_response=$(call_anthropic_api "$prompt") || return 1
      API_CALLS+=1
      json_result=$(parse_json_result "$api_response") || return 1

      if ((USE_CACHE)); then
        if save_to_cache "$cache_key" "$json_result"; then
          success 'Result cached'
        else
          warn "Could not write cache in ${CACHE_DIR@Q}"
        fi
      fi
    fi
  fi

  json_result=$(filter_by_score "$json_result") || { error 'Failed to apply --min-score'; return 1; }

  # Explicit, or a write error would exit with jq's own status (2 = usage error here)
  case $OUTPUT_FORMAT in
    text) format_as_text "$json_result" ;;
    csv)  format_as_csv "$json_result" ;;
    json) format_as_json "$json_result" ;;
    *)    error "Unknown format ${OUTPUT_FORMAT@Q}"; return 1 ;;
  esac || { error 'Failed to write output'; return 1; }
}

#bcscheck disable=BCS0602  # usage errors exit 2 under the published 0/1/2 contract, not 22
validate_and_expand_model() {
  case $1 in
    haiku|haiku-5-5|claude-haiku-5-5)
      ANTHROPIC_MODEL='claude-haiku-5-5'
      ;;
    sonnet|sonnet-5-5|claude-sonnet-5-5)
      ANTHROPIC_MODEL='claude-sonnet-5-5'
      ;;
    opus|opus-5-5|claude-opus-5-5)
      ANTHROPIC_MODEL='claude-opus-5-5'
      ;;
    *)
      die 2 "Invalid model ${1@Q} (use haiku, sonnet, or opus)"
      ;;
  esac
}

# Exit codes are the published contract (0 success, 1 runtime, 2 usage), and -n/-f
# are documented options; both predate BCS0602/BCS0806 and stay for compatibility
#bcscheck disable=BCS0602
#bcscheck disable=BCS0806
main() {
  local -- input_file='' input_text='' out_tmp out_dir cmd
  local -a files=()

  trap cleanup EXIT

  for cmd in curl jq; do
    command -v "$cmd" &>/dev/null || die 1 "$cmd not found (required)"
  done

  while (($#)); do
    case $1 in
      -h|--help)
        show_usage
        exit 0
        ;;
      -V|--version)
        echo "$SCRIPT_NAME $VERSION"
        exit 0
        ;;
      -m|--model)
        noarg "$@"
        validate_and_expand_model "$2"
        shift
        ;;
      -n|--max-keywords)
        noarg "$@"
        int_arg "$1" "$2"
        MAX_KEYWORDS=$2
        shift
        ;;
      -f|--format)
        noarg "$@"
        [[ $2 =~ ^(text|json|csv)$ ]] || die 2 "Invalid format ${2@Q} (use text, json, or csv)"
        OUTPUT_FORMAT=$2
        shift
        ;;
      -s|--scores)
        INCLUDE_SCORES=1
        ;;
      -t|--types)
        INCLUDE_TYPES=1
        ;;
      -e|--entities)
        INCLUDE_ENTITIES=1
        ;;
      --min-score)
        noarg "$@"
        [[ $2 =~ ^(0(\.[0-9]+)?|\.[0-9]+|1(\.0+)?)$ ]] || die 2 "Invalid min-score ${2@Q} (must be 0.0-1.0)"
        MIN_SCORE=$2
        shift
        ;;
      -o|--output)
        noarg "$@"
        OUTPUT_FILE=$2
        shift
        ;;
      --timeout)
        noarg "$@"
        int_arg "$1" "$2"
        API_TIMEOUT=$2
        shift
        ;;
      --max-tokens)
        noarg "$@"
        int_arg "$1" "$2"
        MAX_TOKENS=$2
        shift
        ;;
      -S|--stopwords)
        command -v stopwords &>/dev/null || die 1 'stopwords not found'
        STOPWORDS=1
        ;;
      --no-cache)
        USE_CACHE=0
        ;;
      --cache-dir)
        noarg "$@"
        CACHE_DIR=$2
        shift
        ;;
      -v|--verbose)
        VERBOSE=1
        ;;
      -q|--quiet)
        VERBOSE=0
        ;;
      --dry-run)
        DRY_RUN=1
        ;;
      --)
        shift
        files+=("$@")
        break
        ;;
      -)
        files+=("$1")
        ;;
      -[hVmnfsteoSvq]?*)
        set -- "${1:0:2}" "-${1:2}" "${@:2}"
        continue
        ;;
      -*)
        die 2 "Unknown option ${1@Q}"
        ;;
      *)
        files+=("$1")
        ;;
    esac
    shift
  done

  ((${#files[@]} < 2)) || die 2 'Only one input file is supported'
  input_file=${files[0]:-}

  # ANTHROPIC_MODEL from the environment gets the same check as -m
  validate_and_expand_model "$ANTHROPIC_MODEL"

  readonly ANTHROPIC_MODEL MAX_KEYWORDS API_TIMEOUT MAX_TOKENS STOPWORDS USE_CACHE \
    INCLUDE_SCORES INCLUDE_TYPES INCLUDE_ENTITIES VERBOSE DRY_RUN \
    OUTPUT_FORMAT MIN_SCORE OUTPUT_FILE CACHE_DIR

  # Check the destination now, not after paying for the API call
  if [[ -n $OUTPUT_FILE ]]; then
    if [[ -e $OUTPUT_FILE ]]; then
      [[ -f $OUTPUT_FILE && -w $OUTPUT_FILE ]] || die 1 "Output file not writable ${OUTPUT_FILE@Q}"
    else
      out_dir=.
      [[ $OUTPUT_FILE != */* ]] || out_dir=${OUTPUT_FILE%/*}
      out_dir=${out_dir:-/}
      [[ -d $out_dir && -w $out_dir ]] || die 1 "Output directory not writable ${out_dir@Q}"
    fi
  fi

  if [[ -n $input_file && $input_file != - ]]; then
    [[ -f $input_file ]] || die 1 "File not found ${input_file@Q}"
    [[ -r $input_file ]] || die 1 "File not readable ${input_file@Q}"
    # Reject binary input before paying for an API call; an empty file is left to the
    # empty-input check, since file(1) reports its encoding as binary
    if [[ -s $input_file ]] && command -v file &>/dev/null; then
      [[ $(file -b --mime-encoding -- "$input_file") != binary ]] \
        || die 1 "Input file appears to be binary, not text ${input_file@Q}"
    fi
    input_text=$(< "$input_file")
    info "Reading from ${input_file@Q}"
  else
    [[ ! -t 0 ]] || die 1 'No input file specified and stdin is a terminal'
    input_text=$(cat)
    info 'Reading from stdin'
  fi

  if ((STOPWORDS)); then
    input_text=$(stopwords -p <<< "$input_text") || die 1 'stopwords failed'
  fi

  if [[ -n $OUTPUT_FILE ]]; then
    # Stage the output so a failed extraction leaves an existing file as it was;
    # copying with a redirect keeps the target's own mode and owner
    out_tmp=$(mktemp) || die 1 'Failed to create a temporary file'
    TEMP_FILES+=("$out_tmp")
    extract_keywords "$input_text" > "$out_tmp"
    cat < "$out_tmp" > "$OUTPUT_FILE" || die 1 "Failed to write ${OUTPUT_FILE@Q}"
    info "Output written to ${OUTPUT_FILE@Q}"
  else
    extract_keywords "$input_text"
  fi

  if ((VERBOSE)); then
    >&2 echo
    success 'Extraction complete'
    ((API_CALLS == 0)) || info "API calls: $API_CALLS"
    ((CACHE_HITS == 0)) || info "Cache hits: $CACHE_HITS"
  fi
}

main "$@"
#fin
